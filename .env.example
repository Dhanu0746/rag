# ── LangSmith Tracing (optional) ─────────────────────────────────────────────
# Set to true and add your API key to enable LangSmith request tracing.
# Leave as false if you don't have a LangSmith account — no errors will occur.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=rag-eval-observability

# ── JWT Authentication ────────────────────────────────────────────────────────
# Change this to a long random string in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_EXPIRE_DAYS=1

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Local development (default): Ollama running on your host machine
#   ollama serve
#   ollama pull gemma3:1b
LLM_PROVIDER=ollama

# Ollama base URL — only needed for Docker deployment on Windows/Mac.
# Inside Docker, "localhost" refers to the container, not your host.
# Use host.docker.internal to reach Ollama running on your host machine.
# Local dev (default):   OLLAMA_BASE_URL=http://localhost:11434
# Docker on Windows/Mac: OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Cloud deployment (recommended for Docker): Groq — fast, free tier, no GPU needed
#   1. Sign up at https://console.groq.com
#   2. Create an API key
#   3. Uncomment and set LLM_PROVIDER=groq below
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (optional, highest quality)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ── Grafana ───────────────────────────────────────────────────────────────────
# Admin password for Grafana dashboard (default: admin)
GRAFANA_PASSWORD=admin
